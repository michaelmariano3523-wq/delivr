{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://delivr-inhi.onrender.com/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://delivr-inhi.onrender.com/ws/:path*"
    }
  ]
}
  ]
}
