# ===========================================
# DelivR - Configuração do Ambiente
# ===========================================
# Copie este arquivo para .env.local e preencha com suas credenciais
# NÃO COMMIT ESTE ARQUIVO!

# Supabase (Backend)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Supabase (Frontend - com prefixo VITE_)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=sua-chave-google-maps

# AbacatePay (PIX)
ABACATEPAY_API_KEY=sua-chave-abacatepay

# Servidor
PORT=3000
NODE_ENV=development

# CORS (separados por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
